<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="AlmacenDB"
         connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=Almacen;Integrated Security=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- Nombre que sale como titulo de la factura -->
    <add key="Negocio" value="ALMACÉN" />
    <!-- Tasa de ITBIS (0.18 = 18%) -->
    <add key="TasaItbis" value="0.18" />
    <!-- true: el cajero solo entra en su turno. false: puede entrar a cualquier hora -->
    <add key="ValidarTurno" value="true" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>
